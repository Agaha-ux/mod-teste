-- 🌟 MOD BY AGAH-UX - PARTE 1: Interface com Minimizar e Maximizar

-- Serviços do Roblox
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Garantir que o script esteja no ambiente correto
if not LocalPlayer then
    warn("LocalPlayer não encontrado. Execute no ambiente correto.")
    return
end

-- 🌟 Interface
local gui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
gui.Name = "ModInterface"
gui.ResetOnSpawn = false

-- Fundo da Interface
local background = Instance.new("Frame")
background.Size = UDim2.new(0, 320, 0, 500)
background.Position = UDim2.new(0, 20, 0, 20)
background.BackgroundTransparency = 0.4 -- Opacidade de 60%
background.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Preto
background.Visible = true -- Controlado por minimizar/maximizar
background.Parent = gui

-- Aba Superior
local topBar = Instance.new("Frame")
topBar.Size = UDim2.new(1, 0, 0, 40)
topBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Preto
topBar.BorderSizePixel = 0
topBar.Parent = background

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 1, 0)
title.Text = "MOD BY AGAH-UX"
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
title.TextColor3 = Color3.fromRGB(0, 255, 0)
title.Parent = topBar

-- ScrollFrame
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(1, 0, 1, -50)
scrollFrame.Position = UDim2.new(0, 0, 0, 50)
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0) -- Inicialmente vazio
scrollFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
scrollFrame.ScrollBarThickness = 6
scrollFrame.Parent = background

-- Botões de Minimizar e Maximizar
local minimizeButton = Instance.new("TextButton")
minimizeButton.Size = UDim2.new(0, 100, 0, 40)
minimizeButton.Position = UDim2.new(1, -110, 0, 0) -- Sempre visível na interface
minimizeButton.Text = "Minimizar"
minimizeButton.Font = Enum.Font.Gotham
minimizeButton.TextSize = 14
minimizeButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
minimizeButton.TextColor3 = Color3.fromRGB(0, 255, 0)
minimizeButton.Parent = gui

local isMinimized = false -- Estado atual da interface

local function toggleInterface()
    isMinimized = not isMinimized
    background.Visible = not isMinimized
    minimizeButton.Text = isMinimized and "Maximizar" or "Minimizar"
end

minimizeButton.MouseButton1Click:Connect(toggleInterface)

-- Função para adicionar botões ao ScrollFrame
local buttonCount = 0
local buttonHeight = 50

local function makeButton(name, text, callback)
    local posY = buttonCount * buttonHeight
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Text = text
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.TextColor3 = Color3.fromRGB(0, 255, 0)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 16
    btn.Parent = scrollFrame
    btn.MouseButton1Click:Connect(callback)
    
    buttonCount = buttonCount + 1
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, buttonCount * buttonHeight)
    return btn
end

-- Fly Variables
local flyEnabled = false
local flySpeed = 50
local bodyVelocity, bodyGyro

-- Funções de Fly
local function startFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if not bodyVelocity then
        bodyVelocity = Instance.new("BodyVelocity", hrp)
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVelocity.Velocity = Vector3.zero
    end

    if not bodyGyro then
        bodyGyro = Instance.new("BodyGyro", hrp)
        bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bodyGyro.CFrame = hrp.CFrame
    end
end

local function stopFly()
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

-- Adicionando botão de Fly na interface
makeButton("FlyBtn", "FLY",0,function()
    flyEnabled = not flyEnabled
    if flyEnabled then
        startFly()
    else
        stopFly()
    end
end)

RunService.RenderStepped:Connect(function()
    if flyEnabled and bodyVelocity and bodyGyro and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local moveDir = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").MoveDirection
            bodyVelocity.Velocity = moveDir * flySpeed
            bodyGyro.CFrame = Camera.CFrame
        end
    end
end)

local espEnabled = false
local lines = {}
local boxes = {}

-- Função para criar ESP
local function createESP(player)
    if player == LocalPlayer then return end

    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Color = Color3.fromRGB(255, 0, 0)
    line.Visible = false
    lines[player] = line

    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Visible = false
    boxes[player] = box

    player.CharacterAdded:Connect(function()
        wait(1)
        createESP(player)
    end)
end

local function removeESP(player)
    if lines[player] then lines[player]:Remove() lines[player] = nil end
    if boxes[player] then boxes[player]:Remove() boxes[player] = nil end
end

local function toggleESP()
    espEnabled = not espEnabled
    for _, player in pairs(Players:GetPlayers()) do
        if espEnabled then
            createESP(player)
        else
            removeESP(player)
        end
    end
end

makeButton("ESPBtn", "ESP", 50,toggleESP)

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end

    for player, line in pairs(lines) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            line.Visible = onScreen
            if onScreen then
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
            end
        else
            line.Visible = false
        end
    end
end)
